{
  "defaultProfile": "prod",
  "profiles": {
    "prod": {
      "baseUrl": "https://bonario-vietnam.odoo.com",
      "db": "bonario-vietnam",
      "authMethod": "xmlrpc-api-key",
      "usernameEnv": "ODOO_PROD_USERNAME",
      "apiKeyEnv": "ODOO_PROD_API_KEY",
      "readOnlyDefault": true,
      "allowWrite": false,
      "notes": "Production profile. Require explicit approval before writes, and re-verify IDs, models, and custom fields before execution."
    },
    "test": {
      "baseUrl": "https://testing2007.odoo.com",
      "db": "testing2007",
      "inheritAuthFrom": "prod",
      "authMethod": "xmlrpc-api-key",
      "deriveDbFromHost": true,
      "readOnlyDefault": false,
      "allowWrite": true,
      "notes": "Canonical Odoo test server (only). Old testing* / preview instances removed 2026-07-21."
    }
  },
  "handshakeChecks": [
    "server_version",
    "db",
    "current_user",
    "model_existence",
    "field_existence",
    "write_policy"
  ]
}
